#!/bin/sh
BUNDLE_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)"
if [ -f "$BUNDLE_ROOT/PlanForgeLauncher.sh" ]; then
    REPO_DIR="$BUNDLE_ROOT"
else
    osascript -e 'display alert "PlanForge" message "Keep PlanForge.app inside the PlanForge folder or run InstallApp.command once."' >/dev/null 2>&1 || true
    exit 1
fi
export PATH="/opt/homebrew/bin:/usr/local/bin:/Library/Frameworks/Python.framework/Versions/Current/bin:$PATH"
for arg in "$@"; do
    case "$arg" in
        -psn_*) ;;
        *) set -- "$@" "$arg" ;;
    esac
    shift
done
exec /bin/sh "$REPO_DIR/PlanForgeLauncher.sh" "$@"
