{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:planforge:project:1",
  "title": "PlanForge Project Interchange v1",
  "description": "Versioned, application-neutral PlanForge project exchange document. Dates are ISO date-only values; extensions contain inert JSON data.",
  "type": "object",
  "required": ["format", "schema_version", "project"],
  "properties": {
    "format": { "const": "planforge-project" },
    "schema_version": { "const": 1 },
    "project": { "$ref": "#/$defs/project" }
  },
  "additionalProperties": true,
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "dateOnly": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Calendar date without a time or timezone." },
    "externalIds": {
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced JSON metadata retained from source formats; no active content is executed."
    },
    "customFields": { "type": "object", "additionalProperties": true },
    "workingPeriod": {
      "type": "object",
      "required": ["start", "finish"],
      "properties": {
        "start": { "type": "string", "format": "time" },
        "finish": { "type": "string", "format": "time" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": true
    },
    "calendarException": {
      "type": "object",
      "required": ["start_date", "finish_date", "working", "working_periods", "name", "extensions"],
      "properties": {
        "start_date": { "$ref": "#/$defs/dateOnly" },
        "finish_date": { "$ref": "#/$defs/dateOnly" },
        "working": { "type": "boolean" },
        "working_periods": { "type": "array", "items": { "$ref": "#/$defs/workingPeriod" } },
        "name": { "type": ["string", "null"] },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": true
    },
    "availability": {
      "type": "object",
      "required": ["start_date", "finish_date", "units", "extensions"],
      "properties": {
        "start_date": { "$ref": "#/$defs/dateOnly" },
        "finish_date": { "$ref": "#/$defs/dateOnly" },
        "units": { "type": "number", "minimum": 0 },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": true
    },
    "functionPoints": {
      "type": "object",
      "required": ["counts", "complexities", "function_points", "estimated_hours", "hourly_rate", "estimated_cost", "currency", "extensions"],
      "properties": {
        "counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "complexities": { "type": "object", "additionalProperties": { "type": "string" } },
        "function_points": { "type": ["number", "null"], "minimum": 0 },
        "estimated_hours": { "type": ["number", "null"], "minimum": 0 },
        "hourly_rate": { "type": ["number", "null"], "minimum": 0 },
        "estimated_cost": { "type": ["number", "null"], "minimum": 0 },
        "currency": { "type": ["string", "null"] },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": true
    },
    "task": {
      "type": "object",
      "required": [
        "id", "name", "description", "external_ids", "parent_id", "outline_level", "order",
        "start_date", "finish_date", "duration", "duration_unit", "percent_complete", "priority",
        "milestone", "task_type", "schedule_mode", "calendar_id", "deadline", "constraint_type",
        "constraint_date", "estimated_work", "actual_work", "remaining_work", "work_unit",
        "estimated_cost", "actual_cost", "custom_fields", "function_points", "extensions"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "external_ids": { "$ref": "#/$defs/externalIds" },
        "parent_id": { "type": ["string", "null"] },
        "outline_level": { "type": ["integer", "null"], "minimum": 0 },
        "order": { "type": "integer" },
        "start_date": { "$ref": "#/$defs/dateOnly" },
        "finish_date": { "$ref": "#/$defs/dateOnly" },
        "duration": { "type": ["number", "null"], "minimum": 0 },
        "duration_unit": { "enum": ["minute", "hour", "day", "week", "month", "elapsed_minute", "elapsed_hour", "elapsed_day", "elapsed_week"] },
        "percent_complete": { "type": "number", "minimum": 0, "maximum": 100 },
        "priority": { "type": ["integer", "null"] },
        "milestone": { "type": "boolean" },
        "task_type": { "enum": ["task", "milestone", "summary"] },
        "schedule_mode": { "enum": ["auto", "manual"] },
        "calendar_id": { "type": ["string", "null"] },
        "deadline": { "$ref": "#/$defs/dateOnly" },
        "constraint_type": { "type": ["string", "null"] },
        "constraint_date": { "$ref": "#/$defs/dateOnly" },
        "estimated_work": { "type": ["number", "null"], "minimum": 0 },
        "actual_work": { "type": ["number", "null"], "minimum": 0 },
        "remaining_work": { "type": ["number", "null"], "minimum": 0 },
        "work_unit": { "enum": ["minute", "hour", "day", "week"] },
        "estimated_cost": { "type": ["number", "null"], "minimum": 0 },
        "actual_cost": { "type": ["number", "null"], "minimum": 0 },
        "custom_fields": { "$ref": "#/$defs/customFields" },
        "function_points": { "oneOf": [{ "$ref": "#/$defs/functionPoints" }, { "type": "null" }] },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": true
    },
    "dependency": {
      "type": "object",
      "required": ["id", "predecessor_id", "successor_id", "relationship_type", "lag", "lag_unit", "external_ids", "extensions"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "predecessor_id": { "$ref": "#/$defs/id" },
        "successor_id": { "$ref": "#/$defs/id" },
        "relationship_type": { "enum": ["finish_to_start", "start_to_start", "finish_to_finish", "start_to_finish"] },
        "lag": { "type": "number" },
        "lag_unit": { "enum": ["minute", "hour", "day", "week", "month", "elapsed_minute", "elapsed_hour", "elapsed_day", "elapsed_week"] },
        "external_ids": { "$ref": "#/$defs/externalIds" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": true
    },
    "resource": {
      "type": "object",
      "required": [
        "id", "name", "external_ids", "resource_type", "max_units", "standard_rate", "standard_rate_unit",
        "overtime_rate", "overtime_rate_unit", "cost_per_use", "calendar_id", "availability", "notes",
        "custom_fields", "extensions"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "external_ids": { "$ref": "#/$defs/externalIds" },
        "resource_type": { "type": "string", "description": "Known values are work, material, and cost; other source values are retained with a warning." },
        "max_units": { "type": "number", "minimum": 0 },
        "standard_rate": { "type": ["number", "null"], "minimum": 0 },
        "standard_rate_unit": { "type": "string" },
        "overtime_rate": { "type": ["number", "null"], "minimum": 0 },
        "overtime_rate_unit": { "type": "string" },
        "cost_per_use": { "type": ["number", "null"], "minimum": 0 },
        "calendar_id": { "type": ["string", "null"] },
        "availability": { "type": "array", "items": { "$ref": "#/$defs/availability" } },
        "notes": { "type": "string" },
        "custom_fields": { "$ref": "#/$defs/customFields" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": true
    },
    "assignment": {
      "type": "object",
      "required": [
        "id", "task_id", "resource_id", "units", "work", "work_unit", "actual_work", "remaining_work", "cost",
        "actual_cost", "start_date", "finish_date", "external_ids", "custom_fields", "extensions"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "task_id": { "$ref": "#/$defs/id" },
        "resource_id": { "$ref": "#/$defs/id" },
        "units": { "type": "number", "minimum": 0 },
        "work": { "type": ["number", "null"], "minimum": 0 },
        "work_unit": { "enum": ["minute", "hour", "day", "week"] },
        "actual_work": { "type": ["number", "null"], "minimum": 0 },
        "remaining_work": { "type": ["number", "null"], "minimum": 0 },
        "cost": { "type": ["number", "null"], "minimum": 0 },
        "actual_cost": { "type": ["number", "null"], "minimum": 0 },
        "start_date": { "$ref": "#/$defs/dateOnly" },
        "finish_date": { "$ref": "#/$defs/dateOnly" },
        "external_ids": { "$ref": "#/$defs/externalIds" },
        "custom_fields": { "$ref": "#/$defs/customFields" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": true
    },
    "calendar": {
      "type": "object",
      "required": ["id", "name", "external_ids", "working_days", "working_periods", "holidays", "exceptions", "timezone", "extensions"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "external_ids": { "$ref": "#/$defs/externalIds" },
        "working_days": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 6 } },
        "working_periods": {
          "type": "object",
          "propertyNames": { "pattern": "^[0-6]$" },
          "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/workingPeriod" } }
        },
        "holidays": { "type": "array", "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } },
        "exceptions": { "type": "array", "items": { "$ref": "#/$defs/calendarException" } },
        "timezone": { "type": ["string", "null"] },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": true
    },
    "project": {
      "type": "object",
      "required": [
        "id", "name", "description", "author", "external_ids", "created_at", "modified_at", "start_date", "finish_date",
        "schedule_mode", "default_calendar_id", "currency", "status", "custom_fields", "extensions",
        "tasks", "dependencies", "resources", "assignments", "calendars"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "author": { "type": ["string", "null"] },
        "external_ids": { "$ref": "#/$defs/externalIds" },
        "created_at": { "type": ["string", "null"], "format": "date-time" },
        "modified_at": { "type": ["string", "null"], "format": "date-time" },
        "start_date": { "$ref": "#/$defs/dateOnly" },
        "finish_date": { "$ref": "#/$defs/dateOnly" },
        "schedule_mode": { "enum": ["auto", "manual"] },
        "default_calendar_id": { "type": ["string", "null"] },
        "currency": { "type": "string", "minLength": 1, "maxLength": 16 },
        "status": { "type": ["string", "null"] },
        "custom_fields": { "$ref": "#/$defs/customFields" },
        "extensions": { "$ref": "#/$defs/extensions" },
        "tasks": { "type": "array", "items": { "$ref": "#/$defs/task" } },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
        "resources": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
        "assignments": { "type": "array", "items": { "$ref": "#/$defs/assignment" } },
        "calendars": { "type": "array", "items": { "$ref": "#/$defs/calendar" } }
      },
      "additionalProperties": true
    }
  }
}
