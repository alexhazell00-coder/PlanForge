[Desktop Entry]
Version=1.0
Type=Application
Name=PlanForge
GenericName=Project Planner
Comment=Offline-first project planning, scheduling, and interoperability suite
Exec=sh -c 'exec "$(dirname "$1")/PlanForgeLauncher.sh"' sh %k
Icon=planforge
Terminal=false
Categories=Office;ProjectManagement;Development;
StartupWMClass=PlanForge
MimeType=application/x-planforge-project;
